# Même projet Supabase et clé PUBLIQUE que SWOTmania.
SUPABASE_URL = "https://VOTRE_PROJET.supabase.co"
SUPABASE_PUBLISHABLE_KEY = "VOTRE_CLE_PUBLIQUE_SUPABASE"
# SUPABASE_ANON_KEY est aussi accepté. Ne pas utiliser service_role ou sb_secret.

APP_URL = "https://VOTRE_CONSOBINGO.streamlit.app"
CONSOBINGO_DEMO = false

# Réutiliser l'expéditeur validé et la configuration Brevo des jeux précédents.
BREVO_SENDER_EMAIL = "VOTRE_EXPEDITEUR_VALIDE"
BREVO_SENDER_NAME = "ConsoBingo"
BREVO_SMTP_HOST = "smtp-relay.brevo.com"
BREVO_SMTP_PORT = 587
BREVO_SMTP_USERNAME = "VOTRE_IDENTIFIANT_SMTP_BREVO"
BREVO_SMTP_PASSWORD = "VOTRE_CLE_SMTP_BREVO"
# Alternative : clé API Brevo. Si renseignée, l'API a priorité sur SMTP.
# BREVO_API_KEY = "VOTRE_CLE_API_BREVO"

EMAIL_ATTACH_PDF = true
# Par défaut, l'étudiant choisit explicitement l'envoi de son bilan.
SEND_COMPLETION_EMAILS = false
